# ==============================================================================
# KUBERNETES SECRETS TEMPLATE
# NOTE: Do NOT commit your real unencrypted production secrets to Git!
# Values in Kubernetes Secrets are base64-encoded strings.
# To encode a string in bash/powershell:
#   [Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes("my-password"))
# ==============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: pp-secrets
  namespace: partsandparcel
  labels:
    app.kubernetes.io/name: partsandparcel
type: Opaque
data:
  # base64 representation of APP_KEY (e.g. base64:xxx)
  APP_KEY: "YmFzZTY0OnBsYWNlaG9sZGVyX2tleV9mb3JfcHJvZHVjdGlvbl8zMmNoYXJz"

  # Database Credentials
  DB_USERNAME: "cHBfcHJvZF91c2Vy"         # pp_prod_user
  DB_PASSWORD: "cHByb2Rfc2VjdXJlX3Bhc3N3b3JkXzEyMw==" # pprod_secure_password_123

  # Redis Credentials (if AUTH enabled)
  REDIS_PASSWORD: ""

  # Payment Gateways (Paystack & Flutterwave)
  PAYSTACK_PUBLIC_KEY: "cGtfbGl2ZV9wbGFjZWhvbGRlcl9wdWJsaWNfa2V5"
  PAYSTACK_SECRET_KEY: "c2tfbGl2ZV9wbGFjZWhvbGRlcl9zZWNyZXRfa2V5"
  FLUTTERWAVE_PUBLIC_KEY: "RkxXUFVCSy1wbGFjZWhvbGRlci1Y"
  FLUTTERWAVE_SECRET_KEY: "RkxXU0VDSy1wbGFjZWhvbGRlci1Y"

  # Push Notifications (FCM / Firebase Service Account JSON)
  FCM_SERVER_KEY: "ZmNtX3BsYWNlaG9sZGVyX3NlcnZlcl9rZXk="
